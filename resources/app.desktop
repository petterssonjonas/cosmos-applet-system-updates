[Desktop Entry]
Name=System Updates
Comment=Check system updates hourly and update safely in a terminal
Type=Application
Icon=io.github.cosmic-applet-system-updates-symbolic
Exec=cosmic-applet-system-updates
Terminal=false
StartupNotify=false
Categories=System;PackageManager;
Keywords=Updates;Packages;Fedora;Ubuntu;Arch;COSMIC;
NoDisplay=true
X-CosmicApplet=true
