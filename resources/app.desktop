[Desktop Entry]
Name=Cosmos System Updates
Comment=Check system updates hourly and update safely in a terminal
Type=Application
Icon=dev.jp.CosmosAppletSystemUpdates-symbolic
Exec=cosmos-applet-system-updates
Terminal=false
StartupNotify=false
Categories=System;PackageManager;
Keywords=Updates;Packages;Fedora;Ubuntu;Arch;COSMIC;
NoDisplay=true
X-CosmicApplet=true
